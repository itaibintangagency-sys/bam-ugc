# Salin berkas ini menjadi ".env" (tanpa .example) lalu isi nilainya SENDIRI.
# Jangan kirim berkas .env ke siapa pun dan jangan unggah ke GitHub.

# --- Mode ONLINE (website + Supabase) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
AGENT_EMAIL=
AGENT_PASSWORD=
AGENT_NAME=laptop-produksi-1

# --- Opsional ---
# Folder unduhan Chrome (cadangan jika unduhan tidak tertangkap otomatis)
# DOWNLOAD_DIR=C:\Users\NAMA\Downloads
# Alamat kontrol Chrome (biarkan bawaan kecuali port berbeda)
# CDP_URL=http://127.0.0.1:9222

# Nama agent HARUS BERBEDA untuk setiap laptop. Dua laptop dengan nama sama saling mengambil job yang sedang berjalan.
# (AGENT_NAME di atas hanya dipakai mode online.)

# --- Alat kirim data ke database (mulai.bat menu 8) ---
# Biarkan kosong: kata sandi akan ditanya setiap kali dan TIDAK disimpan. Isi hanya bila laptop ini pribadi.
# STAFF_EMAIL=
# STAFF_PASSWORD=
